{
  "name": "vku-offline-facility-inspection",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node server/server.js",
    "dev:all": "concurrently \"npm run dev:api\" \"npm run dev\"",
    "build": "tsc && vite build",
    "start": "node server/server.js",
    "preview": "vite preview --host 127.0.0.1",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "npm run build && cap sync android && cap open android"
  },
  "dependencies": {
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/network": "^6.0.3",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "localforage": "^1.10.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "cloudflared": "^0.7.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
